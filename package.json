{
  "name": "tagsets-monorepo",
  "private": true,
  "description": "Tagsets: Lucide-style glyphs for standardized metadata codes (licenses, locales, part-of-speech tags, tech abbreviations, keys, math symbols).",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.ts && pnpm run build:packages",
    "build:packages": "tsc -b packages/vanilla packages/react packages/vue",
    "preview": "node scripts/preview.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test",
    "clean": "rm -rf packages/*/dist packages/*/src/generated packages/*/tsconfig.tsbuildinfo preview"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svg-path-bbox": "^2.1.0",
    "svgo": "^4.1.0",
    "tagsets": "workspace:*",
    "tagsets-react": "workspace:*",
    "tagsets-vue": "workspace:*",
    "typescript": "^7.0.2",
    "vue": "^3.5.44"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/componext/tagsets.git"
  }
}
